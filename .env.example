API_ADDR=:8080
SHUTDOWN_TIMEOUT=15s
POSTGRES_PORT=5433
DATABASE_URL=postgres://processor:processor@localhost:5433/processor?sslmode=disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/jobs
# Dead-letter queue the worker consumes to fail jobs whose message was redriven. Empty disables it.
SQS_DLQ_URL=http://localhost:9324/000000000000/jobs-dlq
# Worker /metrics and /healthz listen address.
METRICS_ADDR=:9091
WORKER_CONCURRENCY=4
# Upload size limit when running the Go binaries on the host. The compose stack uses
# DEMO_MAX_UPLOAD_BYTES instead (default 52428800, 50 MB).
MAX_UPLOAD_BYTES=524288000
# API metrics listen address (kept off the public API port; not published by compose).
API_METRICS_ADDR=:9090
# Per-client limit on POST /api/jobs: sustained uploads per minute and burst size. 0 per minute disables it.
UPLOAD_RATE_PER_MIN=10
UPLOAD_RATE_BURST=5
# Finished jobs and their S3 objects older than RETENTION are deleted by the workers, checked every
# RETENTION_INTERVAL. RETENTION=0 keeps everything.
RETENTION=24h
RETENTION_INTERVAL=10m
# Must equal maxReceiveCount of the jobs queue (deploy/elasticmq.conf) so exhausted jobs reach the DLQ.
MAX_ATTEMPTS=3
# Development only: probability (0..1) that the worker injects a transient failure per attempt.
FAIL_RATE=0

# Client identity for rate limits and job caps. false: use the connection's remote address.
# true: use the CF-Connecting-IP header. Enable only when the API is reachable solely through Cloudflare;
# otherwise any client can forge the header.
TRUST_CF_CONNECTING_IP=false
# Mark the per-browser "owner" cookie Secure. Enable when the site is served over HTTPS.
COOKIE_SECURE=false
# An upload that sends no data for UPLOAD_IDLE_TIMEOUT is cut off (408); one may not exceed UPLOAD_MAX_DURATION. 0 disables.
UPLOAD_IDLE_TIMEOUT=30s
UPLOAD_MAX_DURATION=10m
# Uploads streaming at once (more get 503). 0 disables.
MAX_CONCURRENT_UPLOADS=16
# Unfinished (PENDING + PROCESSING) jobs allowed overall (503) and per client (429). 0 disables each.
MAX_UNFINISHED_JOBS=50
MAX_UNFINISHED_PER_CLIENT=3
# Worker: error lines written to errors.csv per job (counts stay exact), and the largest CSV record accepted.
MAX_ERROR_LINES=50000
MAX_RECORD_BYTES=1048576

# Token of a remotely managed Cloudflare Tunnel (Zero Trust > Networks > Tunnels), used by `make public`.
# Keep it in .env only; never commit the real value.
CLOUDFLARE_TUNNEL_TOKEN=
