API_ADDR=:8080
SHUTDOWN_TIMEOUT=15s
POSTGRES_PORT=5433
DATABASE_URL=postgres://processor:processor@localhost:5433/processor?sslmode=disable
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local-access-key
AWS_SECRET_ACCESS_KEY=local-secret-key
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=uploads
SQS_ENDPOINT=http://localhost:9324
SQS_QUEUE_URL=http://localhost:9324/000000000000/jobs
# Dead-letter queue the worker consumes to fail jobs whose message was redriven. Empty disables it.
SQS_DLQ_URL=http://localhost:9324/000000000000/jobs-dlq
# Worker /metrics and /healthz listen address.
METRICS_ADDR=:9091
WORKER_CONCURRENCY=4
# Upload size limit when running the Go binaries on the host. The compose stack uses
# DEMO_MAX_UPLOAD_BYTES instead (default 52428800, 50 MB).
MAX_UPLOAD_BYTES=524288000
# Per-client limit on POST /api/jobs: sustained uploads per minute and burst size. 0 per minute disables it.
UPLOAD_RATE_PER_MIN=10
UPLOAD_RATE_BURST=5
# Finished jobs and their S3 objects older than RETENTION are deleted by the workers, checked every
# RETENTION_INTERVAL. RETENTION=0 keeps everything.
RETENTION=24h
RETENTION_INTERVAL=10m
# Must equal maxReceiveCount of the jobs queue (deploy/elasticmq.conf) so exhausted jobs reach the DLQ.
MAX_ATTEMPTS=3
# Development only: probability (0..1) that the worker injects a transient failure per attempt.
FAIL_RATE=0
